      "length_m": 2.2e-8,
      "ngspice_section": ".include \"${SMC_ROOT}/ptm/22nm_LP.pm\"",
      "ref_device": {
        "ngspice": "m1 d1 g1 s1 b1 nmos l=22n w=0.8u"
